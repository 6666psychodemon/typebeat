# TypeBeat — copy to `.env` and fill in. Do not commit `.env`.

# --- TypeBeat Radio (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback
SESSION_SECRET=
INVITE_ADMIN_TOKEN=

# --- Turso (remote catalog; optional for local dev) ---
# Dev: onthebeat-dev  |  Prod: onthebeat — set in Cursor secrets or local `.env` only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: JEV / TypeSafe tagging scripts ---
TYPESAFE_API_KEY=
